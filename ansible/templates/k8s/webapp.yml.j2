apiVersion: v1
kind: ConfigMap
metadata:
  name: webapp-config
  namespace: {{ k8s_namespace }}
  labels: {app: webapp, env: {{ target_env }}}
data:
  APP_ENV: "{{ target_env }}"
  REDIS_HOST: "redis"
{% if webapp_color %}
  APP_COLOR: "{{ webapp_color }}"
{% endif %}
---
apiVersion: v1
kind: Service
metadata:
  name: redis
  namespace: {{ k8s_namespace }}
  labels: {app: redis, env: {{ target_env }}}
spec:
  clusterIP: None
  selector: {app: redis}
  ports:
    - port: 6379
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: redis
  namespace: {{ k8s_namespace }}
  labels: {app: redis, env: {{ target_env }}}
spec:
  serviceName: redis
  replicas: 1
  selector:
    matchLabels: {app: redis}
  template:
    metadata:
      labels: {app: redis, env: {{ target_env }}}
    spec:
      containers:
        - name: redis
          image: redis:7-alpine
          command: ["sh", "-c", "exec redis-server --requirepass \"$REDIS_PASSWORD\" --appendonly yes"]
          env:
            - name: REDIS_PASSWORD
              valueFrom:
                secretKeyRef: {name: redis-secret, key: password}
          ports:
            - containerPort: 6379
          readinessProbe:
            tcpSocket: {port: 6379}
            periodSeconds: 5
          resources:
            requests: {cpu: 50m, memory: 32Mi}
            limits: {cpu: 200m, memory: 128Mi}
          volumeMounts:
            - {name: data, mountPath: /data}
  volumeClaimTemplates:
    - metadata:
        name: data
      spec:
        accessModes: ["ReadWriteOnce"]
        resources:
          requests: {storage: 256Mi}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: webapp
  namespace: {{ k8s_namespace }}
  labels: {app: webapp, env: {{ target_env }}}
spec:
  replicas: {{ webapp_replicas }}
  revisionHistoryLimit: 5
  strategy:
    type: RollingUpdate
    rollingUpdate: {maxUnavailable: 0, maxSurge: 1}
  selector:
    matchLabels: {app: webapp}
  template:
    metadata:
      labels: {app: webapp, env: {{ target_env }}}
      annotations:
        checksum/config: "{{ (target_env ~ webapp_color) | hash('sha1') }}"
    spec:
      containers:
        - name: webapp
          image: {{ webapp_image }}:{{ app_version }}
          imagePullPolicy: {{ image_pull_policy }}
          ports:
            - containerPort: 5000
          envFrom:
            - configMapRef: {name: webapp-config}
          env:
            - name: REDIS_PASSWORD
              valueFrom:
                secretKeyRef: {name: redis-secret, key: password}
          readinessProbe:
            httpGet: {path: {{ readiness_path }}, port: 5000}
            initialDelaySeconds: 3
            periodSeconds: 5
          livenessProbe:
            httpGet: {path: /health, port: 5000}
            initialDelaySeconds: 10
            periodSeconds: 10
          resources:
            requests: {cpu: 50m, memory: 64Mi}
            limits: {cpu: 250m, memory: 128Mi}
---
apiVersion: v1
kind: Service
metadata:
  name: webapp
  namespace: {{ k8s_namespace }}
  labels: {app: webapp, env: {{ target_env }}}
spec:
  type: NodePort
  selector: {app: webapp}
  ports:
    - port: 80
      targetPort: 5000
      nodePort: {{ node_port }}
